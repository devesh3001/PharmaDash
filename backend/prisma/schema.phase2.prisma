// PharmaDash — PostgreSQL schema tuned for concurrent order/checkout flows.
// https://www.prisma.io/docs/orm/prisma-schema/overview

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
  PHARMACY_ADMIN
  PHARMACIST
}

enum OrderStatus {
  PAYMENT_PENDING
  PENDING
  ACCEPTED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id            String   @id @default(cuid())
  role          UserRole
  phone_number  String   @unique
  full_name     String
  password_hash String
  createdAt     DateTime @default(now())

  orders     Order[] @relation("OrderCustomer")
  deliveries Order[] @relation("OrderRider")
  
  pharmacyId String?
  pharmacy   Pharmacy? @relation("PharmacyStaff", fields: [pharmacyId], references: [id])
  inventoryTransactions InventoryTransaction[]

  @@index([role])
  @@index([pharmacyId])
}

model Pharmacy {
  id        String @id @default(cuid())
  name      String
  latitude  Float
  longitude Float

  inventory Inventory[]
  orders    Order[]
  staff     User[]    @relation("PharmacyStaff")

  @@index([name])
}

model Medicine {
  id                    String  @id @default(cuid())
  name                  String
  generic_name          String
  price                 Decimal @db.Decimal(12, 2)
  requires_prescription Boolean @default(false)

  inventory  Inventory[]
  orderItems OrderItem[]

  @@index([name])
  @@index([generic_name])
}

/// Inventory rows are the hot path for race conditions during checkout.
///
/// **Transaction locking strategy (no negative stock under concurrency):**
/// - Run stock decrements inside a single database transaction with isolation
///   `Serializable` or `Repeatable Read`, or explicitly lock the touched rows first.
/// - For each `(pharmacyId, medicineId)` line item, `SELECT` the inventory row
///   with `FOR UPDATE` (row-level lock) *before* reading `stock_quantity` and
///   computing the new value — e.g. via `prisma.$transaction` + `$queryRaw`
///   `SELECT * FROM "Inventory" WHERE ... FOR UPDATE`, then `UPDATE` only if
///   `stock_quantity >= qty`. The lock serializes competing checkouts on the same SKU.
/// - Alternatively use a **single-statement conditional update** (atomic check-and-set):
///   `UPDATE ... SET stock_quantity = stock_quantity - $qty WHERE id = $id AND stock_quantity >= $qty`
///   and verify `rowsAffected === 1`; retry or abort the outer transaction on failure.
/// - Prisma interactive transactions (`prisma.$transaction(async (tx) => { ... })`)
///   pair naturally with raw `FOR UPDATE` for pessimistic control on high-contention SKUs.
model Inventory {
  id             String @id @default(cuid())
  pharmacyId     String
  medicineId     String

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batches  Batch[]

  @@unique([pharmacyId, medicineId])
  @@index([pharmacyId])
  @@index([medicineId])
}

model Batch {
  id                String   @id @default(cuid())
  inventoryId       String
  batchNumber       String
  quantity          Int
  manufacturingDate DateTime?
  expiryDate        DateTime
  isLegacy          Boolean  @default(false)
  purchasePrice     Decimal? @db.Decimal(12, 2)
  sellingPrice      Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inventory         Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  transactions      InventoryTransaction[]
  allocations       OrderItemBatchAllocation[]

  @@unique([inventoryId, batchNumber])
  @@index([inventoryId])
  @@index([expiryDate]) // For FEFO sorting
}

enum InventoryTransactionType {
  PURCHASE
  ORDER
  RETURN
  CANCELLATION
  ADJUSTMENT
  DAMAGED
  EXPIRED
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  batchId         String
  quantityDelta   Int
  transactionType InventoryTransactionType
  referenceId     String?  // e.g., orderId
  performedById   String?  // userId
  createdAt       DateTime @default(now())

  batch           Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  performedBy     User?    @relation(fields: [performedById], references: [id])

  @@index([batchId])
  @@index([transactionType])
}

model Order {
  id               String      @id @default(cuid())
  customerId       String
  pharmacyId       String
  riderId          String?
  status           OrderStatus @default(PENDING)
  is_emergency     Boolean     @default(false)
  total_amount     Decimal     @db.Decimal(12, 2)
  rating           Int?
  feedback         String?
  delivery_address String?
  delivery_lat     Float?
  delivery_lng     Float?
  createdAt        DateTime    @default(now())

  customer   User        @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  pharmacy   Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  rider      User?       @relation("OrderRider", fields: [riderId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  payment    Payment?

  @@index([customerId])
  @@index([pharmacyId])
  @@index([riderId])
  @@index([status])
  @@index([customerId, status])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  medicineId String
  quantity   Int
  unit_price Decimal @db.Decimal(12, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine    Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  allocations OrderItemBatchAllocation[]

  @@index([orderId])
  @@index([medicineId])
}

model OrderItemBatchAllocation {
  id          String @id @default(cuid())
  orderItemId String
  batchId     String
  quantity    Int

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([batchId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  amount        Decimal  @db.Decimal(12, 2)
  method        String   // "COD" | "MOCK_UPI" | "MOCK_CARD"
  status        String   @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"
  transactionId String?
  createdAt     DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountType    String   // "PERCENTAGE" | "FIXED"
  discountValue   Decimal  @db.Decimal(12, 2)
  minOrderAmount  Decimal? @db.Decimal(12, 2)
  maxDiscount     Decimal? @db.Decimal(12, 2)
  usageLimit      Int?
  usedCount       Int      @default(0)
  active          Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
}

